generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Optional advanced connections (enable only if env vars are defined)
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  // directUrl        = env("DATABASE_DIRECT_URL")
}

model User {
  projectProposalsSent ProjectProposal[] @relation("ProjectProfessional")
  projectProposalsReceived ProjectProposal[] @relation("ProjectClient")
  professionalBlocksReceived ProfessionalBlock[] @relation("BlockedProfessional")
  professionalBlocksSent ProfessionalBlock[] @relation("BlockingClient")
  professionalReportsReceived ProfessionalReport[] @relation("ReportedProfessional")
  professionalReportsSent ProfessionalReport[] @relation("ReportingClient")
  id                        String               @id @default(cuid())
  email                     String               @unique
  emailVerified             DateTime?
  password                  String
  firstName                 String?
  lastName                  String?
  salonName                 String?
  nickname                  String?
  publicVisibility          PublicVisibility     @default(VISIBLE)
  image                     String?
  profileImage              String?
  phone                     String?
  address                   String?
  city                      String?
  postalCode                String?
  instagram                 String?
  website                   String?
  facebook                  String?
  tiktok                    String?
  description               String?
  salonHours                String?
  salonPhotos               String[]
  isInspirationSalon        Boolean              @default(true)

  saasPlan                  SaasPlan             @default(FREE)
  saasPlanUntil             DateTime?

  role                      Role                 @default(user)

  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  prestations               String[]
  style                     String[]

  verifiedSalon            Boolean               @default(false)
  SalonVerificationDocument SalonVerificationDocument[]

  // Contrôle des confirmations de RDV : true = confirmation manuelle, false = confirmation auto
  addConfirmationEnabled    Boolean              @default(false)
  
  // DEPRECATED: Ancien champ pour contrôle agenda (conservé pour compatibilité)
  // À remplacer par salonCanCreateAppointments pour les tatoueurs liés
  appointmentBookingEnabled Boolean              @default(false)

  // Paramètres de réservation pour la prestation PROJET
  // Ces valeurs sont exposées au client lors de la prise de RDV PROJET.
  projectAppointmentDurationMinutes Int?         @default(60)
  projectAppointmentIsFree       Boolean         @default(true)
  projectAppointmentPrice         Float?

  // Paramètres de suivi post-RDV (en jours après completion)
  // Valeurs par défaut: suivi cicatrisation J+7, retouches J+30
  followUpEmailDelayDays         Int             @default(7)
  retouchEmailDelayDays          Int             @default(30)
  
  // Permissions pour user_tatoueur lié à un salon
  // Autorise le user_salon à voir l'agenda et les RDV du user_tatoueur
  salonCanViewAppointments  Boolean              @default(true)
  
  // Permissions pour user_tatoueur lié à un salon
  // Autorise le user_salon à créer des RDV pour ce user_tatoueur
  // À UTILISER dans la logique de création de RDV par salon pour tatoueur lié
  salonCanCreateAppointments Boolean             @default(true)

  colorProfile              String?              @default("default")
  colorProfileBis           String?              @default("default")

  stripeCustomerId          String?              
  stripeSubscriptionId      String?              

  // Lien tatoueur ↔ salon (uniquement pour role user_tatoueur)
  salonId                   String?
  salon                     User?                @relation("SalonTatoueurs", fields: [salonId], references: [id])
  linkedTatoueurs           User[]               @relation("SalonTatoueurs")
  salonResidencies          SalonResidency[]     @relation("ResidencySalon")
  artistResidencies         SalonResidency[]     @relation("ResidencyArtist")
  currentResidencyId         String?
  currentResidencyUntil      DateTime?
  currentResidency           SalonResidency? @relation("SelectedResidency", fields: [currentResidencyId], references: [id], onDelete: SetNull)
  venueAppointments         Appointment[]        @relation("AppointmentVenue")

  appointments              Appointment[]
  appointmentsAsPerformer    Appointment[]        @relation("AppointmentPerformer")
  // Chaque champ correspond à un rôle différent :
  drawingCardsAsSalon         DrawingCard[]         @relation("DrawingCardSalon") // toutes les cards appartenant au salon ;
  drawingCardsAsPerformer     DrawingCard[]         @relation("DrawingCardPerformer") // toutes les cards attribuées à un compte user_tatoueur ;
  drawingCardsAsClient        DrawingCard[]         @relation("DrawingCardClient") // toutes les cards liées au compte d’un client connecté.
  drawingCardNotes            DrawingCardNote[]     @relation("DrawingCardNoteAuthor") // Notes écrites par cet utilisateur
  drawingCardImages           DrawingCardImage[]    @relation("DrawingCardImageUploader") // Images ajoutées par cet utilisateur
  appointmentConsumables    AppointmentConsumable[]
  blockedTimeSlots          BlockedTimeSlot[]

  Client                    Client[]
  FollowUpRequest           FollowUpRequest[]
  FollowUpSubmission        FollowUpSubmission[]

  Portfolio                 Portfolio[]
  Flash                     Flash[]
  ProductSalon              ProductSalon[]

  saasPlanDetails           SaasPlanDetails?
  redeemedInvitation       SubscriptionInvitationRedemption?
  
  Tatoueur                  Tatoueur[]
  TimeSlot                  TimeSlot[]

  StockItem                  StockItem[]
  PiercingPrice             PiercingPrice[]
  PiercingServicePrice      PiercingServicePrice[]

  // Nouvelles propriétés pour les clients
  clientProfile         ClientProfile?
  favoriteUsers         FavoriteUser[]       @relation("ClientFavorites")
  favoritedBy           FavoriteUser[]       @relation("FavoritedSalon")
  favoritePortfolios    FavoritePortfolio[]  @relation("ClientFavoritePortfolios")
  reviewsGiven          SalonReview[]        @relation("ReviewAuthor")
  reviewsReceived       SalonReview[]        @relation("ReviewedSalon")

  // Nouvelle relation pour les RDV pris en tant que client connecté
  appointmentsAsClient      Appointment[]        @relation("ClientUserAppointments")

  linkedClientProfiles      Client[]             @relation("LinkedClientProfile")

  // Propriétés pour la messagerie
  conversationsAsSalon      Conversation[]        @relation("SalonConversations")
  conversationsAsClient     Conversation[]        @relation("ClientUserConversations")
  messagesSent              Message[]
  messageNotifications      MessageNotification[]
  notificationPreference    NotificationPreference?

  // Messagerie multicanale : propriété et délégation, indépendantes des RDV
  inboxThreadsOwned         InboxThread[]         @relation("InboxOwner")
  inboxThreadsAssigned      InboxThread[]         @relation("InboxAssignedUser")
  inboxThreadsAssignedBy    InboxThread[]         @relation("InboxAssignedBy")
  inboxPermissionsAsSalon   InboxMemberPermission[] @relation("InboxPermissionSalon")
  inboxPermissionsAsMember  InboxMemberPermission[] @relation("InboxPermissionMember")
  inboxNotesWritten         InboxInternalNote[]   @relation("InboxNoteAuthor")
  inboxReadStates           InboxReadState[]
  savedRepliesOwned         SavedReply[]          @relation("SavedReplyOwner")
  savedRepliesCreated       SavedReply[]          @relation("SavedReplyCreator")
  channelConnections        ChannelConnection[]
  externalMessagesSent      ExternalMessage[]     @relation("ExternalMessageOperator")

  // Statistiques visites profil public
  salonProfileViews         SalonProfileView[]    @relation("SalonProfileViews")

  // Demandes d'invitation d'équipe (salon -> tatoueur user)
  sentTeamRequests          SalonTatoueurTeamRequest[] @relation("TeamRequestsSentBySalon")
  receivedTeamRequests      SalonTatoueurTeamRequest[] @relation("TeamRequestsReceivedByTatoueur")

  // Index historiques créés en SQL, désormais suivis par Prisma.
  @@index([saasPlan, saasPlanUntil], map: "idx_user_saasPlan_saasPlanUntil")
}

enum PublicVisibility {
  VISIBLE
  SEARCH_HIDDEN
  HIDDEN
}

//! MODEL POUR STOCKER LES INFOS D'UN CLIENT CONNECTÉ
model ClientProfile {
  id          String      @id @default(cuid())
  userId      String      @unique
  pseudo      String?
  birthDate   DateTime?
  city        String?
  postalCode  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodboards  Moodboard[]
}

//! MODEL POUR LES MOODBOARDS (inspirations tattoo du client)
model Moodboard {
  id              String           @id @default(cuid())
  clientProfileId String
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientProfile   ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  images          MoodboardImage[]
  appointments    Appointment[]

  projectStatus   String @default("PRIVATE")
  projectCity     String?
  projectCategory String?
  projectSize     String?
  projectStyles   String[] @default([])
  projectHashtags String[] @default([])
  projectBodyPlacement String?
  projectMobility String?
  projectRadiusKm Int?
  publishedAt DateTime?
  proposals ProjectProposal[]
  proposalEmails ProjectProposalEmail[]

  @@index([clientProfileId])
  @@index([projectStatus, publishedAt])
}

model ProjectProposalEmail {
  id String @id @default(cuid())
  moodboardId String
  threshold Int
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  claimedAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  moodboard Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)

  @@unique([moodboardId, threshold])
  @@index([status, nextAttemptAt])
}

model ProjectProposal {
  id String @id @default(cuid())
  moodboardId String
  professionalId String
  clientUserId String
  conversationId String?
  message String @db.Text
  status String @default("PENDING")
  createdAt DateTime @default(now())
  respondedAt DateTime?
  moodboard Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  professional User @relation("ProjectProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  client User @relation("ProjectClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reports ProfessionalReport[]
  @@unique([moodboardId, professionalId])
  @@index([clientUserId, createdAt])
  @@index([conversationId])
}

model ProfessionalBlock {
  id String @id @default(cuid())
  clientUserId String
  professionalId String
  createdAt DateTime @default(now())
  client User @relation("BlockingClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  professional User @relation("BlockedProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  @@unique([clientUserId, professionalId])
}

model ProfessionalReport {
  id String @id @default(cuid())
  clientUserId String
  professionalId String
  proposalId String?
  reason String @db.Text
  createdAt DateTime @default(now())
  client User @relation("ReportingClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  professional User @relation("ReportedProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  proposal ProjectProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  @@index([createdAt])
}

//! MODEL POUR LES IMAGES D'UN MOODBOARD
model MoodboardImage {
  id          String    @id @default(cuid())
  moodboardId String
  url         String
  caption     String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  moodboard   Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)

  @@index([moodboardId])
}

//! MODEL POUR LES FAVORIS (clients qui ajoutent des salons en favoris)
model FavoriteUser {
  id          String   @id @default(cuid())
  clientId    String
  salonId     String
  createdAt   DateTime @default(now())

  client      User     @relation("ClientFavorites", fields: [clientId], references: [id], onDelete: Cascade)
  salon       User     @relation("FavoritedSalon", fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([clientId, salonId])
}

//! MODEL POUR LES AVIS SUR LES SALONS (clients connectés qui évaluent des salons)
model SalonReview {
  id                    String        @id @default(cuid())
  authorId              String        // Client qui laisse l'avis (role = "client")
  salonId               String        // Salon évalué (role = "user")
  appointmentId         String?       @unique // RDV associé (optionnel mais recommandé pour vérification)
  rating                Int           // Note de 1 à 5
  title                 String?       // Titre de l'avis
  comment               String?       // Commentaire
  photos                String[]      // URLs des photos (optionnel)
  isVerified            Boolean       @default(false) // Avis vérifié (basé sur un RDV réel)
  isVisible             Boolean       @default(true)  // Visible publiquement
  salonResponse         String?       // Réponse du salon
  salonRespondedAt      DateTime?     // Date de réponse du salon
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  
  author                User          @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  salon                 User          @relation("ReviewedSalon", fields: [salonId], references: [id], onDelete: Cascade)
  appointment           Appointment?  @relation(fields: [appointmentId], references: [id])
  
  @@index([salonId])
  @@index([authorId])
  @@index([rating])
  @@index([createdAt])
  @@index([isVisible])
}

//! MODEL POUR TRACKER LES VISITES DU PROFIL PUBLIC SALON
model SalonProfileView {
  id                String    @id @default(cuid())
  salonId           String    // ID du salon (User)
  viewerIpHash      String?   // Hash de l'IP du visiteur (pour anonymiser)
  referrer          String?   // Source du trafic (google, direct, etc.)
  userAgent         String?   // User-Agent du navigateur
  country           String?   // Pays détecté (optionnel)
  city              String?   // Ville détectée (optionnel)
  deviceType        String?   // DESKTOP, MOBILE, TABLET
  createdAt         DateTime  @default(now())
  
  salon             User      @relation("SalonProfileViews", fields: [salonId], references: [id], onDelete: Cascade)
  
  @@index([salonId, createdAt])
  @@index([createdAt])
  @@index([deviceType])
}

//! MODEL POUR LES TATOUEURS DANS LE SALON
model Tatoueur {
  id                 String              @id @default(cuid())
  name               String
  hours              String?
  userId             String
  img                String?
  description        String?
  phone              String?
  instagram          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  skills             String[]
  style              String[]
  rdvBookingEnabled  Boolean             @default(true)
  appointments       Appointment[]
  drawingCards       DrawingCard[] // Cards attribuées à ce tatoueur interne
  blockedTimeSlots   BlockedTimeSlot[]
  assignedInboxThreads InboxThread[]
  Portfolio          Portfolio[]
  Flash              Flash[]
  user               User                @relation(fields: [userId], references: [id])
  TattooHistory      TattooHistory[]

  @@index([userId, rdvBookingEnabled], map: "idx_tatoueur_userId_rdvBookingEnabled")
}

//! MODEL POUR LES RDV
model Appointment {
  photos             AppointmentPhoto[]
  id                 String              @id @default(cuid())
  title              String
  prestation         PrestationType
  start              DateTime
  end                DateTime
  allDay             Boolean             @default(false)
  status             AppointmentStatus   @default(PENDING)
  isPayed            Boolean             @default(false)
  userId             String              // Salon qui reçoit le RDV
  tatoueurId         String?
  performerUserId    String?
  venueSalonId       String?
  venueName          String?
  venueAddress       String?
  venueCity          String?
  venuePostalCode    String?
  venueSalon         User? @relation("AppointmentVenue", fields: [venueSalonId], references: [id], onDelete: SetNull)
  clientId           String?             // Client existant dans la fiche salon (table Client)
  clientUserId       String?             // NOUVEAU: Client connecté (table User avec role="client")
  skin               String?
  tattooDetailId     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  visio              Boolean             @default(false)
  visioRoom          String?
  followUp7SentAt    DateTime?
  followUp30SentAt   DateTime?
  moodboardId        String?             // Moodboard connecté au rdv par le client

  conversation              Conversation?
  inboxThreadLinks          InboxThreadAppointment[]
  
  // Relations existantes
  client             Client?             @relation(fields: [clientId], references: [id])
  tatoueur           Tatoueur?           @relation(fields: [tatoueurId], references: [id])
  user               User                @relation(fields: [userId], references: [id]) // Salon
  performerUser      User?               @relation("AppointmentPerformer", fields: [performerUserId], references: [id])
  drawingCardSource  DrawingCard?        @relation("DrawingCardSource") // Card créée depuis ce RDV
  drawingCardTattoo  DrawingCard?        @relation("DrawingCardTattoo") // Card utilisée pour ce RDV Tattoo
  
  // NOUVELLE relation pour client connecté
  clientUser         User?               @relation("ClientUserAppointments", fields: [clientUserId], references: [id])

  // Moodboard connecté au rdv
  moodboard          Moodboard?          @relation(fields: [moodboardId], references: [id], onDelete: SetNull)

  FollowUpRequest    FollowUpRequest?
  FollowUpSubmission FollowUpSubmission?
  tattooDetail       TattooDetail?
  appointmentConsumables AppointmentConsumable[]
  TimeSlot           TimeSlot[]
  salonReview        SalonReview?

  @@index([userId])
  @@index([performerUserId])
  @@index([venueSalonId, start])
  @@index([clientUserId])
  @@index([status])
  @@index([start])
  @@index([followUp7SentAt])
  @@index([followUp30SentAt])
  @@index([userId, start, status], map: "idx_appointment_userId_start_status")
  @@index([start, end], map: "idx_appointment_start_end")
  @@index([userId, isPayed, start], map: "idx_appointment_userId_isPayed_start")
  @@index([status, userId], map: "idx_appointment_status_userId")
  @@index([tatoueurId, start], map: "idx_appointment_tatoueurId_start")
}

//! CARDS DE SUIVI DES DESSINS
model DrawingCard {
  id                  String             @id @default(cuid()) // Identifiant unique de la card
  salonId             String // Salon propriétaire de la card
  sourceAppointmentId  String             @unique // RDV à l'origine de la card
  tattooAppointmentId  String?            @unique // RDV Tattoo final associé
  clientId             String? // Fiche Client du salon
  clientUserId         String? // Compte client connecté
  tatoueurId           String? // Tatoueur interne du salon
  performerUserId      String? // Compte user_tatoueur
  title                String // Titre visible du projet
  description          String? // Description initiale du projet
  additionalInfo       String? // Informations complémentaires et échanges
  status               DrawingCardStatus  @default(A_DESSINER) // Statut Kanban actuel
  approvedAt           DateTime? // Date d'approbation du dessin
  completedAt          DateTime? // Date de clôture de la card
  createdAt            DateTime           @default(now()) // Date de création
  updatedAt            DateTime           @updatedAt // Date de dernière modification

  salon               User                @relation("DrawingCardSalon", fields: [salonId], references: [id], onDelete: Cascade) // Relation vers le salon
  sourceAppointment   Appointment         @relation("DrawingCardSource", fields: [sourceAppointmentId], references: [id], onDelete: Cascade) // Relation vers le RDV source
  tattooAppointment   Appointment?        @relation("DrawingCardTattoo", fields: [tattooAppointmentId], references: [id], onDelete: SetNull) // Relation vers le RDV Tattoo
  client              Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull) // Relation vers la fiche client
  clientUser          User?               @relation("DrawingCardClient", fields: [clientUserId], references: [id], onDelete: SetNull) // Relation vers le compte client
  tatoueur            Tatoueur?           @relation(fields: [tatoueurId], references: [id], onDelete: SetNull) // Relation vers le tatoueur interne
  performerUser       User?               @relation("DrawingCardPerformer", fields: [performerUserId], references: [id], onDelete: SetNull) // Relation vers le tatoueur connecté
  notes               DrawingCardNote[] // Historique des notes et échanges
  images              DrawingCardImage[] // Versions et fichiers du dessin

  @@index([salonId, status]) // Affichage Kanban par salon et statut
  @@index([clientId]) // Recherche par fiche client
  @@index([clientUserId]) // Recherche par compte client
  @@index([performerUserId]) // Recherche par tatoueur connecté
}

model DrawingCardNote {
  id        String              @id @default(cuid()) // Identifiant unique de la note
  cardId    String // Card concernée
  authorId  String // Utilisateur auteur de la note
  content   String // Contenu de la note ou de l'échange
  type      DrawingCardNoteType @default(INTERNAL) // Catégorie de la note
  createdAt DateTime            @default(now()) // Date de création
  updatedAt DateTime            @updatedAt // Date de modification

  card      DrawingCard @relation(fields: [cardId], references: [id], onDelete: Cascade) // Card parente
  author    User        @relation("DrawingCardNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade) // Auteur

  @@index([cardId, createdAt]) // Timeline de la card
}

model DrawingCardImage {
  id           String   @id @default(cuid()) // Identifiant unique du fichier
  cardId       String // Card concernée
  uploadedById String // Utilisateur ayant ajouté le fichier
  url          String // URL du fichier stocké
  caption      String? // Légende de la version
  version      Int      @default(1) // Numéro de version du dessin
  isApproved   Boolean  @default(false) // Version validée par le client
  createdAt    DateTime @default(now()) // Date d'ajout

  card         DrawingCard @relation(fields: [cardId], references: [id], onDelete: Cascade) // Card parente
  uploadedBy   User        @relation("DrawingCardImageUploader", fields: [uploadedById], references: [id], onDelete: Cascade) // Auteur de l'ajout

  @@index([cardId, createdAt]) // Versions d'une card dans l'ordre chronologique
}

//! MODEL POUR LES DÉTAILS D'UN TATOUAGE DANS UN RDV
model TattooDetail {
  id                      String       @id @default(cuid())
  clientId                String?
  appointmentId           String?      @unique
  description             String
  zone                    String?
  size                    String?
  colorStyle              String?
  reference               String?
  sketch                  String?
  piercingZone            PiercingZone?
  piercingServicePriceId  String?      // ID du service de piercing sélectionné
  estimatedPrice          Float?
  price                   Float?
  isPayed                 Boolean      @default(false)
  appointment             Appointment? @relation(fields: [appointmentId], references: [id])
  client                  Client?      @relation(fields: [clientId], references: [id])
  piercingServicePrice    PiercingServicePrice? @relation(fields: [piercingServicePriceId], references: [id])
}

//! MODELS POUR LA GESTION DES PRIX DE PIERCING
model PiercingPrice {
  id               String          @id @default(cuid())
  userId           String
  piercingZone     PiercingZone
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services         PiercingServicePrice[]
  
  @@unique([userId, piercingZone])
  @@index([userId])
  @@index([piercingZone])
}

model PiercingServicePrice {
  id               String          @id @default(cuid())
  userId           String
  piercingPriceId  String
  piercingZoneOreille  PiercingZoneOreille?
  piercingZoneVisage   PiercingZoneVisage?
  piercingZoneBouche   PiercingZoneBouche?
  piercingZoneCorps    PiercingZoneCorps?
  piercingZoneMicrodermal PiercingZoneMicrodermal?
  price            Float
  description      String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  piercingPrice    PiercingPrice   @relation(fields: [piercingPriceId], references: [id], onDelete: Cascade)
  tattooDetails    TattooDetail[]  // Relation inverse
  
  @@unique([piercingPriceId, piercingZoneOreille, piercingZoneVisage, piercingZoneBouche, piercingZoneCorps, piercingZoneMicrodermal])
  @@index([userId])
  @@index([piercingPriceId])
}

//! MODEL POUR LES CLIENTS DANS LA FICHE SALON
model Client {
  id                 String               @id @default(cuid())
  userId             String
  firstName          String
  lastName           String
  email              String
  phone              String
  birthDate          DateTime?
  address            String?

  consentSigned      Boolean   @default(false)
  consentSignedAt    DateTime?
  consentFileUrl     String?   // PDF signé stocké
  isMinor            Boolean   @default(false)
  guardianName       String?   // Si mineur
  guardianPhone      String?

  tags                 String[]  // Ex: ["VIP", "habitué", "délicat"]
  marketingConsent     Boolean   @default(false) // RGPD obligatoire

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  aftercareRecords   Aftercare[]
  appointments       Appointment[]
  user               User                 @relation(fields: [userId], references: [id])
  drawingCards       DrawingCard[]
  FollowUpSubmission FollowUpSubmission[]
  medicalHistory     MedicalHistory?
  tattooDetails      TattooDetail[]
  tattooHistory      TattooHistory[]

  linkedUserId       String?
  linkedUser         User?                @relation("LinkedClientProfile", fields: [linkedUserId], references: [id], onDelete: SetNull)
  inboxThreads       InboxThread[]

  @@unique([userId, email])
  @@index([linkedUserId])
  @@index([userId, lastName, firstName], map: "idx_client_userId_lastName_firstName")
}

model MedicalHistory {
  id            String  @id @default(cuid())
  clientId      String  @unique
  allergies     String?
  healthIssues  String?
  medications   String?
