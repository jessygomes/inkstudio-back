# Copier les variables dans .env (local) et dans Railway (production), sans les publier.
INSTAGRAM_APP_ID=VOTRE_APP_ID_META
INSTAGRAM_APP_SECRET=VOTRE_SECRET_META

# Doit correspondre à l'URI OAuth configurée dans Meta Developers.
INSTAGRAM_OAUTH_REDIRECT_URI=https://VOTRE-BACKEND/messaging/instagram/callback

# Page existante de l'Inbox sur Inkera Studio (URL complète).
INSTAGRAM_STUDIO_RETURN_URL=https://VOTRE-FRONTEND/URL_DE_L_INBOX

# Choisir des valeurs uniques et secrètes. Voir INSTAGRAM_SETUP.md.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=VALEUR_ALEATOIRE_DISTINCTE
INSTAGRAM_OAUTH_STATE_SECRET=AUTRE_VALEUR_ALEATOIRE_LONGUE
INSTAGRAM_TOKEN_ENCRYPTION_KEY=64_CARACTERES_HEXADECIMAUX_A_GENERER

# Facultatif (v25.0 par défaut côté code, versionner selon Meta Developers).
INSTAGRAM_GRAPH_VERSION=v25.0
